# Keep downloaded launcher bytes/checksums stable across operating systems.
docs/launchers/** -text
docs/START.html -text
# The experiment guide checks the SHA-256 of the original recording and forecast packets.
docs/stages/recording/*.json -text

# The standalone atlas and its signed source assets have identical bytes on every OS.
docs/atlas/** -text
docs/atlas/backslash/atlas.pdf binary
downloads/backslash/*.zip binary

# The atlas viewer on the website is the download's files, checked byte for byte against the ZIP.
docs/viewer/** -text
docs/recorded-cortex/** -text
models/recorded-cortex/** -text
docs/recorded-cortex/*.cmd whitespace=cr-at-eol
docs/cortex-coverage/** -text
docs/cortex-coverage/*.cmd whitespace=cr-at-eol
# Keep the offline reader, original licence and reproducible archive inputs byte-identical.
docs/stride-signals/** -text
models/stride-signals/** -text
docs/stride-signals/*.cmd whitespace=cr-at-eol
models/stride-signals/LICENCE whitespace=cr-at-eol
docs/scalp-and-arm/** -text
docs/scalp-and-arm/*.cmd whitespace=cr-at-eol
# Preserve whitespace in the original published licence and ASA files.
docs/scalp-and-arm/licenses/CC-BY-4.0.txt whitespace=-blank-at-eof
docs/scalp-and-arm/references/*.bnd whitespace=-trailing-space
docs/scalp-and-arm/references/*.vol whitespace=-trailing-space

# Keep the standalone recording reader and archive byte-identical across platforms.
docs/cervical-signals/** -text
docs/cervical-signals/*.cmd whitespace=cr-at-eol
docs/cervical-signals/reference/scalp/*.bnd whitespace=-trailing-space
docs/cervical-signals/reference/scalp/*.vol whitespace=-trailing-space
docs/cervical-signals/reference/CC-BY-4.0.txt whitespace=-blank-at-eof
